APP_NAME=agentguard
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agentguard
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
RISK_CRITICAL_FAILURES_BLOCK=1
RISK_INJECTION_FAILURE_RATE_BLOCK=0.10
RISK_HALLUCINATION_RATE_BLOCK=0.20
RISK_P95_LATENCY_WARNING_MS=1000
